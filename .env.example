# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Server-side API key from Resend (https://resend.com/api-keys)
# used by /api/contact to deliver contact form email submissions.
RESEND_API_KEY="re_your_resend_api_key"

# CONTACT_FROM_EMAIL: Verified sender address in Resend (defaults to Resend's testing sender).
CONTACT_FROM_EMAIL="BoothScript Contact <onboarding@resend.dev>"

# CONTACT_TO_EMAIL: Recipient email address that receives contact form submissions.
CONTACT_TO_EMAIL="you@example.com"
